FROM python:3.12-slim

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Copy python project dependencies
COPY adminserver/pyproject.toml /app/

# Install system dependencies
RUN apt-get update && apt-get install -y sudo docker.io && rm -rf /var/lib/apt/lists/*

# Install python dependencies using uv
RUN uv pip install --system -r pyproject.toml

# Copy project files
COPY adminserver/ /app/

# Collect static files
RUN python manage.py collectstatic --noinput

EXPOSE 8000

CMD ["gunicorn", "--bind", "0.0.0.0:8000", "adminserver.wsgi:application"]
